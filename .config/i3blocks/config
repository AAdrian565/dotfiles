[mic_status]
command=bash -c 'STATUS=$(pactl list sources | grep -A 6 "$(pactl get-default-source)" | grep "Mute" | awk '\''{print $2}'\''); if [ "$STATUS" = "yes" ]; then echo "MUTE"; else echo ""; fi'
interval=1
signal=10
color=#FF0000

[volume]
command=bash -c 'sink=$(pactl get-default-sink); case "$sink" in *CX31993*) icon="🎧" ;; *hdmi*) icon="🔊" ;; *) icon="🔊" ;; esac; volume=$(pactl get-sink-volume "$sink" | awk -F/ "NR == 1 { gsub(/ /, \"\", \$2); print \$2 }"); muted=$(pactl get-sink-mute "$sink" | awk "{ print \$2 }"); if [ "$muted" = yes ]; then printf " %s " "$icon"; else printf " %s %s " "$icon" "$volume"; fi'
interval=1
signal=11

[wireless]
command=sh -c 'if command -v iwgetid >/dev/null 2>&1; then iwgetid -r; else nmcli -t -f active,ssid dev wifi 2>/dev/null | awk -F: '\''$1 == "yes" {sub(/^yes:/, ""); print; exit}'\''; fi' | awk 'NF {print " " $0 " "}'
interval=5
color=#1E90FF  # DodgerBlue

[ethernet]
command=ip -4 addr show $(ip route | awk '/default/ {print $5}') | awk '/inet / {print " lan: "$2 " "}'
interval=5
color=#7FFFD4  # Aquamarine

[cpu_usage]
command=top -bn1 | grep 'Cpu(s)' | awk '{printf(" C: %.1f%% ", 100 - $8)}'
interval=1

[memory]
command=free | awk '/Mem:/ {printf(" R: %.1f%% ", $3/$2*100)}'
interval=1

[disk]
command=df -h / | awk 'NR==2 {printf(" D: %s ", $4)}'
interval=30

[power]
command=$HOME/script/power_status.sh
interval=30

[tztime]
command=date '+%a, %d %b %Y - %H:%M:%S' | awk '{print " " $0 " "}'
interval=1
