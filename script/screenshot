#!/usr/bin/env bash

set -u

usage() {
	cat <<'EOF'
Usage: screenshot [area|window|output|screen] [copy-save|copy|save|ocr]

Environment:
  OCR_LANG       Tesseract language (default: eng)
  SCREENSHOT_DIR Destination directory (default: Pictures/Screenshots)
EOF
}

notify() {
	command -v notify-send >/dev/null 2>&1 && notify-send -a Screenshot "$@"
}

fail() {
	printf 'screenshot: %s\n' "$*" >&2
	notify -u critical 'Screenshot failed' "$*"
	exit 1
}

copy_image() {
	local file=$1
	if [[ -n "${WAYLAND_DISPLAY:-}" ]] && command -v wl-copy >/dev/null 2>&1; then
		wl-copy --type image/png < "$file"
	elif command -v xclip >/dev/null 2>&1; then
		xclip -selection clipboard -t image/png -i "$file"
	else
		return 1
	fi
}

copy_text() {
	if [[ -x "$HOME/script/clipboard" ]]; then
		"$HOME/script/clipboard" copy
	elif [[ -n "${WAYLAND_DISPLAY:-}" ]] && command -v wl-copy >/dev/null 2>&1; then
		wl-copy --type text/plain
	elif command -v xclip >/dev/null 2>&1; then
		xclip -selection clipboard -i
	else
		return 1
	fi
}

capture_wayland() {
	local mode=$1 file=$2 geometry
	if command -v grimblast >/dev/null 2>&1; then
		case "$mode" in
			area) grimblast save area "$file" ;;
			window) grimblast save active "$file" ;;
			output) grimblast save output "$file" ;;
			screen) grimblast save screen "$file" ;;
		esac
		return
	fi

	command -v grim >/dev/null 2>&1 || return 127
	case "$mode" in
		area)
			command -v slurp >/dev/null 2>&1 || fail 'Install slurp for Wayland area selection.'
			geometry=$(slurp) || return
			[[ -n "$geometry" ]] || return 1
			grim -g "$geometry" "$file"
			;;
		window)
			command -v hyprctl >/dev/null 2>&1 || fail 'Active-window capture requires grimblast or Hyprland.'
			command -v jq >/dev/null 2>&1 || fail 'Active-window capture requires jq.'
			geometry=$(hyprctl -j activewindow | jq -r '"\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"') || return
			grim -g "$geometry" "$file"
			;;
		output)
			command -v hyprctl >/dev/null 2>&1 || fail 'Active-output capture requires grimblast or Hyprland.'
			command -v jq >/dev/null 2>&1 || fail 'Active-output capture requires jq.'
			geometry=$(hyprctl -j monitors | jq -r '.[] | select(.focused) | "\(.x),\(.y) \(.width)x\(.height)"') || return
			[[ -n "$geometry" && "$geometry" != null ]] || return 1
			grim -g "$geometry" "$file"
			;;
		screen) grim "$file" ;;
	esac
}

active_output_geometry() {
	local active_geometry active_x active_y window_x window_y window_width window_height
	local output status rest output_width output_height output_x output_y
	local xrandr_output

	command -v xdotool >/dev/null 2>&1 || return 127
	command -v xrandr >/dev/null 2>&1 || return 127

	active_geometry=$(xdotool getactivewindow getwindowgeometry --shell 2>/dev/null || true)
	window_x=$(awk -F= '$1 == "X" {print $2}' <<< "$active_geometry")
	window_y=$(awk -F= '$1 == "Y" {print $2}' <<< "$active_geometry")
	window_width=$(awk -F= '$1 == "WIDTH" {print $2}' <<< "$active_geometry")
	window_height=$(awk -F= '$1 == "HEIGHT" {print $2}' <<< "$active_geometry")
	if [[ "$window_x" =~ ^-?[0-9]+$ && "$window_y" =~ ^-?[0-9]+$ &&
		"$window_width" =~ ^[0-9]+$ && "$window_height" =~ ^[0-9]+$ ]]; then
		active_x=$((window_x + window_width / 2))
		active_y=$((window_y + window_height / 2))
	else
		active_geometry=$(xdotool getmouselocation --shell 2>/dev/null || true)
		active_x=$(awk -F= '$1 == "X" {print $2}' <<< "$active_geometry")
		active_y=$(awk -F= '$1 == "Y" {print $2}' <<< "$active_geometry")
		[[ "$active_x" =~ ^-?[0-9]+$ && "$active_y" =~ ^-?[0-9]+$ ]] || return 1
	fi

	xrandr_output=$(xrandr --query 2>/dev/null) || return 1
	while read -r output status rest; do
		[[ "$status" == connected ]] || continue
		if [[ "$rest" =~ ([0-9]+)x([0-9]+)([+-][0-9]+)([+-][0-9]+) ]]; then
			output_width=${BASH_REMATCH[1]}
			output_height=${BASH_REMATCH[2]}
			output_x=${BASH_REMATCH[3]}
			output_y=${BASH_REMATCH[4]}
			if (( active_x >= output_x && active_x < output_x + output_width &&
				active_y >= output_y && active_y < output_y + output_height )); then
				printf '%sx%s%+d%+d\n' "$output_width" "$output_height" "$output_x" "$output_y"
				return 0
			fi
		fi
	done <<< "$xrandr_output"

	return 1
}

capture_x11() {
	local mode=$1 file=$2 geometry window_id width height x y
	if command -v maim >/dev/null 2>&1; then
		case "$mode" in
			area)
				if command -v slop >/dev/null 2>&1; then
					geometry=$(slop --shader=focus --highlight --bordersize=0 \
						--color=1,1,1,0.25 --format=%g) || return
					[[ -n "$geometry" ]] || return 1
					sleep 0.15
					maim --hidecursor --geometry "$geometry" "$file"
				else
					maim --noopengl --tolerance=0 --hidecursor --select "$file"
				fi
				;;
			window)
				command -v xdotool >/dev/null 2>&1 || fail 'Active-window capture requires xdotool.'
				window_id=$(xdotool getactivewindow) || return
				maim --window "$window_id" "$file"
				;;
			output)
				geometry=$(active_output_geometry) || return
				maim --hidecursor --geometry "$geometry" "$file"
				;;
			screen) maim "$file" ;;
		esac
		return
	fi

	command -v scrot >/dev/null 2>&1 || return 127
	case "$mode" in
		area) scrot --select "$file" ;;
		window) scrot --focused "$file" ;;
		output)
			geometry=$(active_output_geometry) || return
			if [[ "$geometry" =~ ^([0-9]+)x([0-9]+)([+-][0-9]+)([+-][0-9]+)$ ]]; then
				width=${BASH_REMATCH[1]}
				height=${BASH_REMATCH[2]}
				x=${BASH_REMATCH[3]}
				y=${BASH_REMATCH[4]}
				scrot --autoselect "$x,$y,$width,$height" "$file"
			else
				return 1
			fi
			;;
		screen) scrot "$file" ;;
	esac
}

mode=${1:-area}
action=${2:-copy-save}
case "$mode" in
	area|window|output|screen) ;;
	-h|--help) usage; exit 0 ;;
	*) usage >&2; exit 2 ;;
esac
case "$action" in
	copy-save|copy|save|ocr) ;;
	*) usage >&2; exit 2 ;;
esac

pictures_dir=''
if command -v xdg-user-dir >/dev/null 2>&1; then
	pictures_dir=$(xdg-user-dir PICTURES 2>/dev/null || true)
fi
pictures_dir=${pictures_dir:-$HOME/Pictures}
screenshot_dir=${SCREENSHOT_DIR:-$pictures_dir/Screenshots}
mkdir -p "$screenshot_dir" || fail "Cannot create $screenshot_dir"
file="$screenshot_dir/$(date '+%Y-%m-%d_%H-%M-%S')_${mode}.png"

if [[ -n "${WAYLAND_DISPLAY:-}" ]]; then
	capture_wayland "$mode" "$file" || {
		status=$?
		((status == 127)) && fail 'Install grim (and slurp for area selection) to take Wayland screenshots.'
		exit "$status"
	}
else
	capture_x11 "$mode" "$file" || {
		status=$?
		((status == 127)) && fail 'Install maim or scrot to take X11 screenshots.'
		exit "$status"
	}
fi

[[ -s "$file" ]] || exit 1

case "$action" in
	save)
	notify 'Screenshot saved' "$file"
	;;
	copy-save)
		copy_image "$file" || fail 'Install wl-clipboard (Wayland) or xclip (X11) to copy images.'
		notify 'Screenshot copied and saved' "$file"
		;;
	copy)
		copy_image "$file" || fail 'Install wl-clipboard (Wayland) or xclip (X11) to copy images.'
		rm -f -- "$file"
		notify 'Screenshot copied'
		;;
	ocr)
		command -v tesseract >/dev/null 2>&1 || fail 'Install tesseract and a language data package to use OCR.'
		text=$(tesseract "$file" stdout -l "${OCR_LANG:-eng}" 2>/dev/null) || fail 'Tesseract could not read the screenshot.'
		[[ -n "$text" ]] || fail 'No text was detected.'
		printf '%s' "$text" | copy_text || fail 'Install wl-clipboard (Wayland) or xclip (X11) to copy OCR text.'
		notify 'OCR copied to clipboard' "$(printf '%s' "$text" | head -c 120)"
		;;
esac
